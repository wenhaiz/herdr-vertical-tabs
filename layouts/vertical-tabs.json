{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "chrome-fold"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "tree",
          "type": "block",
          "content": {
            "mod": "vertical-tabs"
          },
          "size": {
            "weight": 2
          },
          "min": 120
        },
        {
          "id": "agents",
          "type": "block",
          "content": {
            "mod": "agents-fold"
          },
          "size": {
            "weight": 1
          },
          "min": 28
        }
      ],
      "size": {
        "px": 280
      },
      "min": 44,
      "max": 560,
      "background": "chrome",
      "resizable": true
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane-cwdless"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes-picker"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ]
        },
        {
          "id": "bottom",
          "type": "row",
          "size": {
            "px": 28
          },
          "children": [
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "status-cwd"
              },
              "size": {
                "weight": 1
              }
            },
            {
              "id": "panel-toggles",
              "type": "block",
              "content": {
                "mod": "panel-toggles"
              },
              "size": {
                "px": 170
              }
            }
          ]
        }
      ]
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/vertical-tabs.svg"
}
